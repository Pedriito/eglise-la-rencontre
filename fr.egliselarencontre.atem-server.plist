<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchDaemon — démarre au boot du Mac mini (avant login).
  Installation :
    sudo cp fr.egliselarencontre.atem-server.plist /Library/LaunchDaemons/
    sudo launchctl load /Library/LaunchDaemons/fr.egliselarencontre.atem-server.plist

  Vérifier que node est bien à /opt/homebrew/bin/node :
    which node

  Logs : /var/log/atem-server.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>fr.egliselarencontre.atem-server</string>

    <key>UserName</key>
    <string>eglisehorizon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/eglisehorizon/eglise-la-rencontre/atem-server.mjs</string>
        <string>10.0.0.107</string>
        <string>0</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/eglisehorizon/eglise-la-rencontre</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/var/log/atem-server.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/atem-server.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/eglisehorizon</string>
    </dict>
</dict>
</plist>
