{
  "name": "@eglise/ui",
  "version": "0.1.0",
  "description": "Design system de l'Église La Rencontre — composants et jetons partagés",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/styles/tokens.css",
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tailwindcss -i src/styles/index.css -o dist/styles.css --minify",
    "prepare": "npm run build",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "build:css": "tailwindcss -i src/styles/index.css -o dist/styles.css --minify"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19",
    "typescript": "^5"
  },
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pedriito/eglise-la-rencontre.git",
    "directory": "packages/ui"
  }
}
